# Required to generate new written briefs and Grok Voice spoken recaps.
# https://console.x.ai/
XAI_API_KEY=

# Cookie signing secret. Any long random string is fine for local use.
AUTH_SECRET=replace-me-with-a-long-random-string

# Local default: SQLite file created at prisma/dev.db.
# On Vercel this MUST be a hosted Postgres URL so Follow survives across instances.
# Neon pooled example (no real credentials here): postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=file:./prisma/dev.db
