generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// prisma.config.ts rewrites provider to postgresql when DATABASE_URL is a Postgres URL.
datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  follows      Follow[]
}

model Show {
  id          String    @id @default(cuid())
  itunesId    String    @unique
  title       String
  artist      String
  feedUrl     String
  artworkUrl  String?
  description String    @default("")
  createdAt   DateTime  @default(now())
  follows     Follow[]
  episodes    Episode[]
}

model Follow {
  userId      String
  showId      String
  briefLength String   @default("medium")
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  show        Show     @relation(fields: [showId], references: [id], onDelete: Cascade)

  @@id([userId, showId])
}

model Episode {
  id          String      @id @default(cuid())
  showId      String
  guid        String
  title       String
  publishedAt DateTime
  link          String?
  audioUrl         String?
  transcriptUrl    String?
  durationSeconds  Int?
  description   String      @default("")
  guest         String?
  seeded      Boolean     @default(false)
  createdAt   DateTime    @default(now())
  show        Show        @relation(fields: [showId], references: [id], onDelete: Cascade)
  brief       Brief?
  recapAudio  RecapAudio?
  sttJob      SttJob?

  @@unique([showId, guid])
}

model Brief {
  id             String   @id @default(cuid())
  episodeId      String   @unique
  overview       String
  segmentsJson   String
  takeawaysJson  String
  spokenRecap    String
  sourceType     String
  confidenceNote String?
  guest          String?
  briefLength    String   @default("medium")
  sourceLimited  Boolean  @default(false)
  createdAt      DateTime @default(now())
  episode        Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
}

model RecapAudio {
  id               String   @id @default(cuid())
  episodeId        String   @unique
  mimeType         String   @default("audio/mpeg")
  data             Bytes
  durationSeconds  Int?
  createdAt        DateTime @default(now())
  episode          Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
}

/** Durable Grok STT progress so a 3-hour episode can finish across many function turns. */
model SttJob {
  id              String    @id @default(cuid())
  episodeId       String    @unique
  audioUrl        String
  nextByte        Int       @default(0)
  totalBytes      Int?
  chunkCount      Int       @default(0)
  coveredSeconds  Int       @default(0)
  text            String    @default("")
  status          String    @default("pending")
  error           String?
  lockedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  episode         Episode   @relation(fields: [episodeId], references: [id], onDelete: Cascade)
}
